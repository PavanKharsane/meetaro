JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional local administrator account. Configure both values to enable review tools.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Zoho Mail SMTP. Create an app-specific password in Zoho and keep it private.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=meetaro@zohomail.in
SMTP_PASSWORD=
MAIL_FROM=Meetaro <meetaro@zohomail.in>
HOST_APPLICATION_NOTIFY_EMAIL=meetaro@zohomail.in
